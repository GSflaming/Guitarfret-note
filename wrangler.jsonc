{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guitarfret-note",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": false
  },
  "env": {
    "production": {
      "name": "guitarfret-note"
    }
  }
}
